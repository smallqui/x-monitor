# X account to monitor.
# Enter the username without the @ symbol.
TWITTER_USERNAME=username

# Discord webhook URL used to send new status notifications.
# Create one in:
# Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=

# X authentication cookies used by playwright to access the account while logged in.
# To find these:
# 1. Log into https://x.com in your browser.
# 2. Open DevTools.
# 3. Go to Application -> Cookies -> https://x.com
# 4. Copy the values for "auth_token" and "ct0".
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Base delay between status checks, in milliseconds.
# I recommend a value between 10000 - 30000 to avoid ratelimits.
# Minimum allowed value: 5000 (5 seconds).
# A small randomized delay of up to 3 seconds is added automatically.
MONITOR_DELAY=30000

# Whether the latest status should be sent to Discord when the monitor first starts.
# true  = send the latest status on startup
# false = use the latest status as the starting point without sending it
NOTIFY_ON_STARTUP=true